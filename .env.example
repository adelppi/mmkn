# 環境変数テンプレート — mmkn
#
# 値は空。**このファイルに秘密情報を書かない。**
# 実際の値を入れたものは .env.local に置く（.gitignore 済み）。
#
# 区分の定義と、分ける理由は adr/0003-tech-stack.md「環境変数の区分」を正とする。
# どの値がどの区分かの一覧は docs/operations.md「環境変数」を正とする。
#
# ---------------------------------------------------------------
# 名前は 6 つしかない。**同じ名前が環境ごとに違う値を持つ。**
#
#   名前                    Vercel      GitHub Actions   手元
#   DATABASE_URL            本番/6543   本番/5432        Docker
#   SUPABASE_URL            ○           —                ○
#   SUPABASE_ANON_KEY       ○           —                ○
#   DISCORD_PUBLIC_KEY      ○           —                ○
#   DISCORD_BOT_TOKEN       **置かない** ○               —
#   DISCORD_APPLICATION_ID  **置かない** ○               —
#
# 用途ごとに別名を作らない。置き場所が違えば値は衝突しない。
# **読むコードが存在しない変数を先に作らない。**
# ---------------------------------------------------------------


# ============================================================
# DB
# ============================================================

# データアクセス（ORM が使う）。adr/0005
#
# 値は環境ごとに違う。
#   Vercel          … Supavisor の transaction mode（6543）
#   GitHub Actions  … マイグレーション用。**Vercel と同じ transaction mode（6543）でよい**
#                     （2026-08-14 に確認済み。adr/0011「着手時の確認結果」）
#   手元            … docker-compose.yml の Postgres。次の値でそのまま動く:
#                     postgresql://mmkn:mmkn@127.0.0.1:5432/mmkn
#
# 接続文字列はダッシュボードの Connect からコピーする
# （pooler のホスト名はプロジェクトごとに違い、推測できない）。
#
# **prepared statement の無効化はドライバの設定で行う。** 接続文字列に付ける
# `?pgbouncer=true` は Prisma 固有のフラグで、Drizzle は読まない。付けると
# 「無効化した」と誤解するだけなので付けない（postgres.js の prepare: false で
# 行っている。src/infra/db/client.ts）。
#
# **手元の値に本番を書かない。** E2E が作った記録が実データに混ざる（adr/0011）。
# 永続化テストは回るたびに DB の中身を空にするため、本番を指していると
# そこにあるデータを消す。**接続先がループバックでなければ永続化テストは落ちる**
# （src/infra/db/test-support.ts）が、開発サーバー・マイグレーションの適用には
# その歯止めが無い。
DATABASE_URL=


# ============================================================
# 認証（Supabase Auth）
# ============================================================

# adr/0007 / adr/0012
#
# **データには使わないが、認証には要る。** adr/0005 の「データアクセスには
# 使わない」は経路の話であって、この 2 つが不要という意味ではない。
# アプリは実行時に Supabase Auth を呼ぶ（Google / Discord でのログイン・
# ログアウト・ログイン手段の追加と削除・セッションの読み取り）。認証の
# エンドポイントは apikey ヘッダを要求するため、URL と鍵の両方が要る。
#
# **メールに関わる値は無い。** mmkn はパスワードを持たず、メールも送らない
# （adr/0012）。確認メールも再設定メールも発生しない。
#
#   DATABASE_URL ........ データ
#   SUPABASE_URL / KEY .. 認証
#
# 役割が重なっていないので、どちらも消せない。
#
# プロジェクト URL のみ。**末尾に /rest/v1/ を付けない**
# （それは PostgREST = データアクセスの経路であり、adr/0005 が使わないと
# 決めているもの）。
SUPABASE_URL=

# 新形式の publishable key（sb_publishable_…）を使う。legacy の anon JWT でも
# 動くが、新形式は JWT secret のローテーションに巻き込まれず独立して失効
# させられる。どちらも公開前提のキーであり、秘密情報ではない。
SUPABASE_ANON_KEY=


# ============================================================
# Discord
# ============================================================

# Interaction の署名検証（Ed25519）。adr/0006
# 公開鍵であり、Bot Token とは別物。**アプリが実行時に要るのはこれだけ。**
DISCORD_PUBLIC_KEY=

# スラッシュコマンドの登録。adr/0006 / adr/0011 のリリース 4 段目
#
# **この 2 つをホスティング環境に置かない**（adr/0011「秘密情報の置き場」）。
# 署名検証は公開鍵で行うため、アプリは Bot Token を必要としない。
# 置いても使われず、露出面だけが増える。
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=


# ============================================================
# ブラウザへの露出（決着済み）
# ============================================================
#
# **SUPABASE_URL / SUPABASE_ANON_KEY をブラウザに露出しない。**
# NEXT_PUBLIC_ 接頭辞付きの名前は作らない（features.md #11 / adr/0012 の実装で決着）。
#
# 認証基盤を呼ぶのはサーバーだけであるため。ログインもログイン手段の追加も、認可画面の URL を
# サーバーで作ってリダイレクトで送り出し、戻り先（app/auth/callback）でも
# サーバーが往復を完了させる。cookie の読み書きもサーバーで行う
# （src/infra/auth/ と app/_lib/session.ts）。ブラウザで認証基盤の SDK を動かす
# 経路が無いため、露出させる理由が無い。
