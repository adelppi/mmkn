# 環境変数テンプレート — mmkn
#
# 値は空。**このファイルに秘密情報を書かない。**
# 実際の値を入れたものは .env / .env.local に置く（.gitignore 済み）。
#
# 区分の定義と、分ける理由は adr/0003-tech-stack.md「環境変数の区分」を正とする。
# どの値がどの区分かの一覧は docs/operations.md「環境変数」を正とする。
#
# 区分を取り違えても、その場では何も起きない。ホスティング環境に置くべき値を
# 手元にしか置かなければ本番でだけ動かず、リリースの自動処理が読む値を
# ホスティング環境に置いても無視される。どちらも切り分けの難しい形で出る。
# このファイルはその取り違えを防ぐためにある。


# ============================================================
# 1. アプリが実行時に読む
#    置き場所: ホスティング環境（Vercel のプロジェクト設定）
#    読む主体: デプロイされたアプリ
# ============================================================

# データアクセス（ORM が使う）。adr/0005
# Supavisor の transaction mode（ポート 6543）に接続する。5432 に直接繋がない。
# transaction mode では prepared statement が使えないため、ドライバ側で無効化する。
DATABASE_URL=

# 認証・セッション管理。adr/0007 / adr/0012
# データアクセスには使わない（データアクセスは上の DATABASE_URL + ORM）。adr/0005
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Discord の Interaction の署名検証（Ed25519）。adr/0006
# 公開鍵であり、Bot Token とは別物。アプリが実行時に必要とするのはこちらだけ。
DISCORD_PUBLIC_KEY=


# ============================================================
# 2. リリースの自動処理が読む
#    置き場所: GitHub の秘密情報（Actions secrets）
#    読む主体: GitHub Actions（adr/0011）
#
#    **ここの値をホスティング環境に置かない。** アプリが実行時に使わない値を
#    置いても使われず、露出面だけが増える（adr/0011「秘密情報の置き場」）。
# ============================================================

# 本番 DB へのマイグレーションの適用。adr/0011 のリリース 2 段目
# 区分 1 の DATABASE_URL と同じ値で足りるかは未確認（下の「未確認」を参照）。
MIGRATION_DATABASE_URL=

# スラッシュコマンドの登録。adr/0006 / adr/0011 のリリース 4 段目
# **Bot Token はホスティング環境に置かない**（署名検証は公開鍵で行うため、
# アプリは Bot Token を必要としない）。
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=


# ============================================================
# 3. 手元の作業だけが読む
#    置き場所: ローカルのみ（.env.local）
#    読む主体: 開発サーバー・永続化テスト・E2E・診断コマンド
# ============================================================

# 手元の Postgres（Docker）。開発サーバー・永続化テスト・E2E が使う。adr/0010
# 本番の DATABASE_URL をここに書かない。E2E が作った記録が実データに混ざる。
LOCAL_DATABASE_URL=

# コマンド登録の差分を見る診断で、ギルド単位の登録先を指定する。adr/0006
# ギルド単位の登録は即時反映、グローバル登録は最大 1 時間かかる。
DISCORD_GUILD_ID=


# ============================================================
# 未確認（Issue #9 で確認できていないもの）
# ============================================================
#
# - 区分 2 の MIGRATION_DATABASE_URL が、区分 1 の DATABASE_URL と同じ値で
#   足りるか。アプリ側は Supavisor の transaction mode を前提としており、
#   そこでは prepared statement が使えない（adr/0003 / adr/0005）。
#   同じ値で足りるなら、この変数は消して DATABASE_URL に寄せる。
#
# - SUPABASE_URL / SUPABASE_ANON_KEY をブラウザに露出する必要があるか。
#   露出が要るなら Next.js の NEXT_PUBLIC_ 接頭辞付きの名前になる。
#   要否はアカウント作成・ログインの実装（features.md #11 / adr/0012）で決まる。
#
# - 診断コマンド（docs/operations.md「診断」）が読む値。診断の実体がまだ無い。
